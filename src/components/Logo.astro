---
import Image from '~/components/common/Image.astro';
//import logoImg from '~/assets/images/cropped-Logo-für-Menue-4.png';
// Use string path instead of import to avoid Vite warning about dynamic/static import conflict
const logoImg = '~/assets/images/Kreuz-bunt.svg';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-[#1e3257] whitespace-nowrap dark:text-[#dce9f7]"
>
  <Image class="rounded-full" src={logoImg} alt="Logo" width="60px" height="60px" />
</span>
<span class="text-base text-secondary dark:text-[#93b3e0] font-bold tracking-wide uppercase">Messiaskapelle</span>
