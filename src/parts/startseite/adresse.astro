---
import Features2 from '~/components/widgets/Features2.astro';
import { SITE } from '~/utils/config';
import OpenStreetMap from '~/components/svelte/OpenStreetMap.svelte';


const view: [number, number] = [48.2231769, 16.3641052];
const zoom = 17;
const minZoom = 12;
const maxZoom = 19;
const marker: [number, number] = [48.2231769, 16.3641052];
const markerPopup = 'Evangelische Messiaskapelle<br>1090 Wien, Seegasse 16a';
const imagePath = typeof SITE.base !== 'string' ? '/' : SITE.base.toString();
const markerPath = imagePath + (imagePath.endsWith('/') ? '' : '/') + 'leaflet/images/';
---

<!-- Leitbild -->
<Features2
  id="adresse"
  title="So kommen Sie zu uns"
  tagline="Unsere Adresse"
  classes={{ container: 'max-w-3xl' }}
>
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
  </Fragment>
  <Fragment slot="subtitle">
    Evangelische Pfarrgemeinde A.B. Wien-Alsergrund-Messiaskapelle<br/>
    1090 Wien, Seegasse 16a
    <br /><br />
    <span class="block h-fit pb-0 md:pb-0">
        <OpenStreetMap
          client:only="svelte"
          view={view}
          zoom={zoom}
          minZoom={minZoom}
          maxZoom={maxZoom}
          marker={marker}
          markerPopup={markerPopup}
          markerPath={markerPath}
        />
      </span>
    <br /><br />
    Sie erreichen uns am besten mit der U-Bahnlinie U4 (Station Rossauer Lände, Ausgang Seegasse) oder mit der Straßenbahnlinie D (Haltestelle Seegasse).
    <br /><br />
    Beachten Sie bitte die Kurzparkzone Mo–Fr von 9:00–22:00<br/> sowie die Anrainer-Parkplätze Mo-So ganztägig.
  </Fragment>
</Features2>
